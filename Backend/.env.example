# Copia este archivo como .env y ajusta los valores.
FLASK_ENV=development
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Clave para firmar los JWT (usa una distinta de SECRET_KEY, mínimo 32 caracteres aleatorios)
# Generar una: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=cambia-esto-por-otra-clave-larga-y-aleatoria-de-32-o-mas-caracteres
# Duración del token en horas
JWT_EXPIRA_HORAS=8

# Conexión a MySQL/MariaDB (XAMPP: usuario root y contraseña vacía por defecto)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hospitalizacion_db

# Orígenes del frontend permitidos por CORS (separados por coma)
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
