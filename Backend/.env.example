# Copia este archivo como .env y ajusta los valores.
FLASK_ENV=development
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Conexión a MySQL/MariaDB (XAMPP: usuario root y contraseña vacía por defecto)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hospitalizacion_db

# Orígenes del frontend permitidos por CORS (separados por coma)
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
